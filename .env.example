# Copy the relevant values into backend/.env for local development.
# Never commit a real API key.
RELAPAW_ENV=development
RELAPAW_DEPLOYMENT_VERSION=development
# Staging/production require PostgreSQL and explicit HTTPS origins.
RELAPAW_DATABASE_URL=sqlite:///./relapaw.db
RELAPAW_CORS_ORIGINS=["http://localhost:5173"]
# Runtime AI stays off unless this is explicitly enabled. A configured key does not enable it.
RELAPAW_AI_ENABLED=false
# AI remains unreachable unless a reviewed qualification record is explicitly selected.
RELAPAW_MODEL_QUALIFICATION=NOT_QUALIFIED
# RELAPAW_MODEL_QUALIFICATION_ID=
RELAPAW_MEDICAL_KNOWLEDGE_VERSION=medical-safety/v1
RELAPAW_MEDICAL_REVIEW_STATUS=PENDING
# Demo only: set this to the absolute path of this repository's frontend/dist.
# RELAPAW_STATIC_DIR=E:\Relapaw\frontend\dist
OPENAI_API_KEY=
RELAPAW_OPENAI_MODEL=
# Optional OpenAI-compatible Responses endpoint (for example, Alibaba Model Studio).
RELAPAW_OPENAI_BASE_URL=
# Stored with each AnalysisRun for auditability (for example: openai or qwen).
RELAPAW_MODEL_PROVIDER=openai
RELAPAW_OPENAI_TIMEOUT_SECONDS=20
RELAPAW_OPENAI_MAX_OUTPUT_TOKENS=1600
# Browser identity/session. Replace the pepper outside local development.
RELAPAW_SESSION_PEPPER=development-only-change-me
RELAPAW_SESSION_ABSOLUTE_DAYS=30
RELAPAW_SESSION_IDLE_DAYS=7
# Local invited-Beta adapter only; forbidden in staging and production.
# RELAPAW_LOCAL_INVITE_CODE=
# Production refuses draft or unapproved policy configuration.
RELAPAW_TERMS_VERSION=terms-draft-2026-10-20
RELAPAW_PRIVACY_VERSION=privacy-draft-2026-10-20
RELAPAW_LEGAL_DOCUMENTS_APPROVED=false
RELAPAW_ACCOUNT_DELETION_GRACE_DAYS=7
RELAPAW_AUDIT_RETENTION_DAYS=365
