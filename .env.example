# Copy the relevant values into backend/.env for local development.
# Never commit a real API key.
OPENAI_API_KEY=
RELAPAW_OPENAI_MODEL=
# Optional OpenAI-compatible Responses endpoint (for example, Alibaba Model Studio).
RELAPAW_OPENAI_BASE_URL=
# Stored with each AnalysisRun for auditability (for example: openai or qwen).
RELAPAW_MODEL_PROVIDER=openai
RELAPAW_OPENAI_TIMEOUT_SECONDS=20
RELAPAW_OPENAI_MAX_OUTPUT_TOKENS=1600
